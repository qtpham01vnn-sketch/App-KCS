import React, { useState, useRef, useEffect, useMemo } from 'react';
import { 
  LayoutDashboard, FileText, ShieldCheck, ScanLine, 
  ChevronRight, User, UploadCloud, BrainCircuit, 
  AlertTriangle, CheckCircle2, ClipboardCheck, ArrowRight,
  Database as DatabaseIcon, Save, Image as ImageIcon, X,
  Activity, Ruler, Wind, Gauge, Search, History, TrendingUp, BarChart3,
  Loader2, CloudUpload, Calendar, Eye, Printer, RefreshCcw, Zap, Thermometer,
  FileSpreadsheet, Download, Layers, ArrowLeftRight, Box, Beaker, ClipboardList,
  Cpu, UserCheck, Flame, Layers2, Timer, Sun, Moon, Info, Edit3, MessageSquare, Send, Bot
} from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import { supabase } from './lib/supabase';
import { runOCR } from './lib/gemini';
import { PRODUCTS, KILN_RULES } from './lib/constants';
import clsx from 'clsx';
import { twMerge } from 'tailwind-merge';

// Helper for tailwind class merging
function cn(...inputs) {
  return twMerge(clsx(inputs));
}

export default function App() {
  // --- STATES ---
  const [activeMenu, setActiveMenu] = useState('Bảng điều khiển');
  const [step, setStep] = useState(1);
  const [selectedImages, setSelectedImages] = useState([]);
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [isSaving, setIsSaving] = useState(false);
  const [hmiData, setHmiData] = useState(null); 
  const [cloudLogs, setCloudLogs] = useState([]);
  const [localError, setLocalError] = useState(""); 
  
  const [compareIdA, setCompareIdA] = useState(null);
  const [compareIdB, setCompareIdB] = useState(null);

  const fileInputRef = useRef(null);
  
  // CHATBOT STATES
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [chatInput, setChatInput] = useState('');
  const [chatMessages, setChatMessages] = useState([
    { role: 'ai', text: 'Chào Anh Tuấn, Trợ lý KCS AI đã sẵn sàng hỗ trợ anh đối soát dải nhiệt và áp suất mẻ nung. 🤖' }
  ]);
  const [isChatting, setIsChatting] = useState(false);
  const chatEndRef = useRef(null);
  
  const now = new Date();
  
  const [formData, setFormData] = useState({
    day: now.getDate().toString(),
    month: (now.getMonth() + 1).toString(),
    year: now.getFullYear().toString(),
    caTruc: 'Ca Ngày', 
    truongCa: 'Phạm Quốc Tuấn',
    caTruong: '',
    maGach: PRODUCTS[1], // CERAMIC ốp 40X80
    loaiLo: 'Lò Men',
    lucBe: '', benUon: '', doDay: '', hutNuoc: '',
    baiXuong: '', baiMenEngobe: '', baiMenNen: ''
  });

  // --- EFFECT ---
  useEffect(() => {
    fetchLogs();
  }, []);

  const fetchLogs = async () => {
    const { data, error } = await supabase
      .from('kiln_dryer_reports')
      .select('*')
      .order('created_at', { ascending: false });
    
    if (data) {
      setCloudLogs(data);
      if (data.length >= 2) {
        setCompareIdA(data[0].id);
        setCompareIdB(data[1].id);
      }
    }
  };

  const handleInputChange = (field, value) => {
    setFormData(prev => {
      const newData = { ...prev, [field]: value };
      if (field === 'maGach') {
          newData.loaiLo = value.includes('50X50') || value.includes('60X60') || value.includes('80X80') ? 'Lò Men' : 'Lò Xương';
      }
      return newData;
    });
  };

  // --- IMAGE HANDLING ---
  const handleFileChange = async (event) => {
    const files = Array.from(event.target.files);
    if (files.length === 0) return;
    
    const newImages = await Promise.all(files.map(file => {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onloadend = () => {
          resolve({ 
            preview: URL.createObjectURL(file), 
            base64: reader.result.split(',')[1], 
            mimeType: file.type 
          });
        };
        reader.readAsDataURL(file);
      });
    }));
    setSelectedImages(prev => [...prev, ...newImages]);
  };

  const startAnalysis = async () => {
    if (selectedImages.length === 0) return;
    setIsAnalyzing(true);
    setLocalError("");
    try {
      const rawData = await runOCR(selectedImages);
      
      const { startMod, endMod, isEvenAllowed } = KILN_RULES.getRange(formData.maGach, formData.loaiLo);
      
      const filteredModules = rawData.nhietDo.filter(m => {
        const num = parseInt(m.id.replace(/\D/g, ''));
        if (num < startMod || num > endMod) return false;
        if (!isEvenAllowed && num % 2 === 0 && num !== 62) return false;
        return true;
      }).sort((a, b) => parseInt(a.id.replace(/\D/g, '')) - parseInt(b.id.replace(/\D/g, '')));

      setHmiData({ ...rawData, filteredModules });
      setStep(4);
    } catch (error) {
      setLocalError(`Lỗi AI: ${error.message || "Không thể kết nối API"}. Vui lòng kiểm tra console hoặc API Key.`);
      console.error("Analysis Error:", error);
    } finally {
      setIsAnalyzing(false);
    }
  };

  const saveToSupabase = async () => {
    setIsSaving(true);
    try {
      const { error } = await supabase
        .from('kiln_dryer_reports')
        .insert([{
          batch_code: formData.maGach,
          product_type: formData.maGach,
          kiln_type: formData.loaiLo,
          lab_info: JSON.stringify(formData),
          moisture_percent: 0, // Placeholder
          strength_value: formData.lucBe,
          kiln_data: hmiData,
          raw_ai_response: JSON.stringify(hmiData)
        }]);
      
      if (!error) {
        setActiveMenu('Cơ sở dữ liệu');
        fetchLogs();
        setStep(1);
        setHmiData(null);
        setSelectedImages([]);
      }
    } catch (error) {
      console.error(error);
    } finally {
      setIsSaving(false);
    }
  };

  // --- RENDER COMPONENTS ---
  const SidebarItem = ({ id, icon: Icon, label }) => (
    <button
      onClick={() => setActiveMenu(label)}
      className={cn(
        "w-full flex items-center gap-4 px-6 py-4 rounded-2xl transition-all duration-300",
        activeMenu === label 
          ? "bg-brand-primary/10 text-brand-primary active-glow border border-brand-primary/20" 
          : "text-white/40 hover:bg-white/5"
      )}
    >
      <Icon size={20} className={activeMenu === label ? "text-brand-primary" : ""} />
      <span className="text-xs font-black uppercase tracking-widest">{label}</span>
    </button>
  );

  return (
    <div className="flex h-screen w-full bg-[#050505] text-white overflow-hidden font-['Outfit']">
      {/* SIDEBAR */}
      <aside className="w-[280px] p-6 flex flex-col border-r border-white/5 bg-[#080808]">
        <div className="flex items-center gap-4 mb-12 px-2">
          <div className="w-12 h-12 bg-brand-primary/20 rounded-2xl flex items-center justify-center border border-brand-primary/30">
            <Flame className="text-brand-primary" size={24} />
          </div>
          <div>
            <h2 className="font-black text-xl tracking-tighter uppercase leading-tight">App KCS</h2>
            <p className="text-[10px] font-bold text-brand-primary/60 uppercase tracking-[2px]">Industrial AI</p>
          </div>
        </div>
        
        <nav className="flex-1 space-y-2">
          <SidebarItem icon={LayoutDashboard} label="Bảng điều khiển" />
          <SidebarItem icon={ScanLine} label="Đối soát KCS" />
          <SidebarItem icon={ArrowLeftRight} label="So sánh dải nhiệt" />
          <SidebarItem icon={DatabaseIcon} label="Cơ sở dữ liệu" />
        </nav>

        <div className="glass-card p-6 rounded-[2rem] mt-auto">
          <p className="text-[10px] font-black text-brand-primary uppercase mb-1 tracking-widest">User Profile</p>
          <p className="text-xs font-black truncate text-white/80 italic">Anh Tuấn - Phó phòng CN</p>
        </div>
      </aside>

      {/* MAIN CONTENT */}
      <main className="flex-1 overflow-y-auto p-12 bg-[radial-gradient(circle_at_top_right,_rgba(212,176,123,0.05),_transparent_40%)]">
        <header className="flex justify-between items-center mb-12">
          <div>
            <h1 className="text-4xl font-black uppercase tracking-tighter mb-2 italic">{activeMenu}</h1>
            <div className="flex items-center gap-2">
              <div className="w-2 h-2 bg-emerald-500 rounded-full animate-pulse shadow-[0_0_10px_#10b981]"></div>
              <p className="text-[10px] font-black text-white/30 uppercase tracking-[4px]">System Online | Cloud Synced</p>
            </div>
          </div>
          
          <div className="flex items-center gap-6 glass-card p-2 pr-8 rounded-full">
            <div className="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center border border-white/10 font-black text-brand-primary">AT</div>
            <div className="text-left">
              <p className="text-sm font-black uppercase tracking-tight">Phạm Quốc Tuấn</p>
              <p className="text-[10px] font-bold text-brand-primary/60 uppercase">Phó phòng Công nghệ</p>
            </div>
          </div>
        </header>

        {activeMenu === 'Bảng điều khiển' && (
          <div className="grid grid-cols-1 md:grid-cols-3 gap-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
            <div className="glass-card p-8 rounded-[2.5rem] flex flex-col justify-between h-[200px]">
              <p className="text-[11px] font-black text-white/30 uppercase tracking-widest">Mẻ lưu hệ thống</p>
              <span className="text-6xl font-black">{cloudLogs.length}</span>
              <div className="flex items-center gap-2 text-emerald-500 text-[10px] font-black uppercase tracking-widest">
                <CheckCircle2 size={14} /> Dữ liệu đã đồng bộ
              </div>
            </div>
            <div className="glass-card p-8 rounded-[2.5rem] bg-brand-primary/5 border-brand-primary/20 flex flex-col justify-between h-[200px]">
              <p className="text-[11px] font-black text-brand-primary uppercase tracking-widest">Tỉ lệ đạt ISO</p>
              <span className="text-6xl font-black text-brand-primary">98%</span>
              <div className="h-1.5 bg-white/5 rounded-full overflow-hidden">
                <div className="h-full bg-brand-primary w-[98%] shadow-[0_0_15px_#D4B07B]"></div>
              </div>
            </div>
            <div className="glass-card p-8 rounded-[2.5rem] flex flex-col justify-between h-[200px]">
              <p className="text-[11px] font-black text-white/30 uppercase tracking-widest">Trạng thái AI</p>
              <div className="flex items-center gap-4">
                <BrainCircuit size={48} className="text-brand-primary" />
                <span className="text-2xl font-black text-white">READY</span>
              </div>
              <p className="text-[10px] font-bold text-white/20 uppercase tracking-widest">Gemini 2.0 Flash Engine</p>
            </div>
          </div>
        )}

        {activeMenu === 'Đối soát KCS' && (
          <div className="max-w-5xl mx-auto space-y-12 animate-in fade-in duration-500">
            {/* Steps Navigation */}
            <div className="glass-card p-8 rounded-[2.5rem] flex justify-between items-center relative">
              {[1, 2, 3, 4].map((s) => (
                <div key={s} className="flex items-center gap-4 z-10">
                  <div className={cn(
                    "w-10 h-10 rounded-full flex items-center justify-center font-black transition-all duration-500",
                    step >= s ? "bg-brand-primary text-brand-bg shadow-[0_0_20px_#D4B07B]" : "bg-white/5 text-white/20 border border-white/10"
                  )}>{s}</div>
                  <span className={cn(
                    "text-[10px] font-black uppercase tracking-widest",
                    step >= s ? "text-brand-primary" : "text-white/20"
                  )}>{['Thông tin Lab', 'Nạp ảnh HMI', 'AI Phân tích', 'Kết quả ISO'][s-1]}</span>
                </div>
              ))}
              <div className="absolute top-1/2 left-0 w-full h-[1px] bg-white/5 -z-0"></div>
            </div>

            {step === 1 && (
              <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="glass-card p-12 rounded-[3rem] space-y-12">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-12">
                  <div className="space-y-6">
                    <label className="text-[10px] font-black text-brand-primary uppercase tracking-widest">I. Sản phẩm & Ca trực</label>
                    <select 
                      value={formData.maGach} 
                      onChange={(e) => handleInputChange('maGach', e.target.value)}
                      className="w-full bg-white/5 border border-white/10 p-5 rounded-2xl font-black text-sm outline-none focus:border-brand-primary transition-all"
                    >
                      {PRODUCTS.map(p => <option key={p} value={p}>{p}</option>)}
                    </select>
                    <div className="grid grid-cols-2 gap-4">
                      <input type="text" placeholder="Tên ca trưởng" value={formData.caTruong} onChange={(e)=>handleInputChange('caTruong', e.target.value)} className="bg-white/5 border border-white/10 p-5 rounded-2xl font-black text-sm outline-none focus:border-brand-primary" />
                      <select value={formData.caTruc} onChange={(e)=>handleInputChange('caTruc', e.target.value)} className="bg-white/5 border border-white/10 p-5 rounded-2xl font-black text-sm outline-none">
                        <option>Ca Ngày</option><option>Ca Đêm</option>
                      </select>
                    </div>
                  </div>
                  <div className="space-y-6">
                    <label className="text-[10px] font-black text-brand-primary uppercase tracking-widest">II. Chỉ số Lab</label>
                    <div className="grid grid-cols-2 gap-4">
                      <div className="space-y-2">
                        <p className="text-[9px] font-bold text-white/30 uppercase">Lực bẻ (N)</p>
                        <input type="number" value={formData.lucBe} onChange={(e)=>handleInputChange('lucBe', e.target.value)} className="w-full bg-white/5 border border-white/10 p-5 rounded-2xl font-black text-2xl outline-none focus:border-brand-primary" />
                      </div>
                      <div className="space-y-2">
                        <p className="text-[9px] font-bold text-white/30 uppercase">Độ dày (mm)</p>
                        <input type="number" value={formData.doDay} onChange={(e)=>handleInputChange('doDay', e.target.value)} className="w-full bg-white/5 border border-white/10 p-5 rounded-2xl font-black text-2xl outline-none focus:border-brand-primary" />
                      </div>
                    </div>
                  </div>
                </div>
                <button onClick={()=>setStep(2)} className="w-full bg-brand-primary text-brand-bg py-8 rounded-[2.5rem] font-black uppercase tracking-[4px] shadow-[0_0_30px_rgba(212,176,123,0.3)] hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-4">
                  Tiếp theo <ArrowRight size={24} />
                </button>
              </motion.div>
            )}

            {step === 2 && (
              <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className="glass-card p-12 rounded-[3rem] text-center space-y-12 border-2 border-dashed border-white/5">
                <input type="file" multiple className="hidden" ref={fileInputRef} onChange={handleFileChange} />
                {selectedImages.length === 0 ? (
                  <div onClick={()=>fileInputRef.current.click()} className="py-12 cursor-pointer group">
                    <div className="w-32 h-32 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-8 border border-white/10 group-hover:border-brand-primary group-hover:scale-110 transition-all">
                      <UploadCloud size={48} className="text-brand-primary" />
                    </div>
                    <h3 className="text-2xl font-black uppercase mb-2">Tải ảnh HMI Modena</h3>
                    <p className="text-white/30 text-xs font-bold uppercase tracking-widest">Nhiệt PV | Quạt | Áp suất</p>
                  </div>
                ) : (
                  <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
                    {selectedImages.map((img, i) => (
                      <div key={i} className="relative aspect-video rounded-2xl overflow-hidden border border-white/10">
                        <img src={img.preview} className="w-full h-full object-cover" />
                        <button onClick={()=>setSelectedImages(prev => prev.filter((_, idx)=>idx!==i))} className="absolute top-2 right-2 p-1 bg-black/60 rounded-lg"><X size={14}/></button>
                      </div>
                    ))}
                    <div onClick={()=>fileInputRef.current.click()} className="aspect-video rounded-2xl border-2 border-dashed border-white/10 flex items-center justify-center cursor-pointer hover:bg-white/5 transition-all">
                      <Plus size={24} className="text-white/20" />
                    </div>
                  </div>
                )}
                <button 
                  disabled={selectedImages.length === 0 || isAnalyzing}
                  onClick={startAnalysis}
                  className="w-full bg-brand-primary text-brand-bg py-8 rounded-[2.5rem] font-black uppercase tracking-[4px] flex items-center justify-center gap-4 disabled:opacity-20"
                >
                  {isAnalyzing ? <Loader2 className="animate-spin" size={24}/> : <BrainCircuit size={24} />}
                  {isAnalyzing ? "Đang phân tích..." : "Phân tích AI Vision"}
                </button>

                {localError && (
                  <div className="bg-red-500/10 border border-red-500/20 p-6 rounded-2xl flex items-center gap-4 text-red-500">
                    <AlertTriangle size={20} />
                    <p className="text-xs font-black uppercase tracking-widest">{localError}</p>
                  </div>
                )}
              </motion.div>
            )}

            {step === 4 && hmiData && (
              <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="space-y-8 pb-24">
                <div className="glass-card p-12 rounded-[3rem] bg-emerald-500/5 border-emerald-500/20 flex justify-between items-center">
                  <div className="flex items-center gap-8">
                    <div className="w-20 h-20 bg-emerald-500/20 rounded-[2rem] flex items-center justify-center border border-emerald-500/30 text-emerald-500">
                      <CheckCircle2 size={40} />
                    </div>
                    <div>
                      <h3 className="text-2xl font-black uppercase tracking-tight">AI Phân tích hoàn tất</h3>
                      <p className="text-white/40 text-xs font-bold uppercase tracking-widest">Dữ liệu đã sẵn sàng để đối soát và lưu trữ</p>
                    </div>
                  </div>
                  <div className="flex gap-4">
                    <button onClick={()=>setStep(1)} className="glass-btn px-8 py-5 rounded-2xl font-black text-xs uppercase tracking-widest">Làm lại</button>
                    <button onClick={saveToSupabase} disabled={isSaving} className="bg-brand-primary text-brand-bg px-10 py-5 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg flex items-center gap-3">
                      {isSaving ? <Loader2 className="animate-spin" size={16}/> : <Save size={16}/>} Lưu Database
                    </button>
                  </div>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
                  {/* Kiln Temperature Table */}
                  <div className="glass-card rounded-[3rem] overflow-hidden">
                    <div className="p-8 bg-white/5 border-b border-white/5 flex justify-between items-center">
                      <h4 className="text-sm font-black uppercase tracking-widest flex items-center gap-3 text-brand-primary">
                        <Thermometer size={18}/> Dải nhiệt độ PV
                      </h4>
                      <span className="text-[10px] bg-brand-primary/20 text-brand-primary px-4 py-1 rounded-full font-black">CHU KỲ: {hmiData.chuKy} PHÚT</span>
                    </div>
                    <div className="p-4 max-h-[500px] overflow-y-auto">
                      <table className="w-full text-left font-bold text-[11px]">
                        <thead className="text-white/20 uppercase text-[9px] tracking-widest">
                          <tr className="border-b border-white/5">
                            <th className="p-4">Zone</th>
                            <th className="p-4 text-center">Nhiệt Trên (PV)</th>
                            <th className="p-4 text-center text-blue-400">Nhiệt Dưới (PV)</th>
                            <th className="p-4 text-right">ISO</th>
                          </tr>
                        </thead>
                        <tbody>
                          {(() => {
                            // Grouping logic: Pair Mxx and M0xx
                            const zones = [];
                            const processed = new Set();
                            
                            hmiData.filteredModules.forEach(m => {
                              const zoneId = m.id.replace(/\D/g, '');
                              if (processed.has(zoneId)) return;
                              
                              const top = hmiData.filteredModules.find(x => x.id === `M${zoneId}`);
                              const bottom = hmiData.filteredModules.find(x => x.id === `M0${zoneId}`);
                              
                              zones.push({ id: zoneId, top, bottom });
                              processed.add(zoneId);
                            });

                            return zones.map((z, i) => (
                              <tr key={i} className="border-b border-white/[0.02] hover:bg-white/5 transition-all">
                                <td className="p-4 text-brand-primary font-black">Z.{z.id}</td>
                                <td className="p-4 text-center text-base font-black">
                                  {z.top ? z.top.pv : "---"}
                                </td>
                                <td className="p-4 text-center text-base font-black text-blue-400">
                                  {z.bottom ? z.bottom.pv : "---"}
                                </td>
                                <td className="p-4 text-right">
                                  <span className="text-emerald-500 text-[10px] font-black uppercase tracking-tighter bg-emerald-500/10 px-2 py-1 rounded border border-emerald-500/20">Đạt</span>
                                </td>
                              </tr>
                            ));
                          })()}
                        </tbody>
                      </table>
                    </div>
                  </div>

                  {/* Pressure & Fans */}
                  <div className="space-y-8">
                    <div className="glass-card p-8 rounded-[3rem] space-y-6">
                      <h4 className="text-[11px] font-black uppercase tracking-widest opacity-40 flex items-center gap-3"><Gauge size={16}/> Áp suất âm Pa</h4>
                      <div className="grid grid-cols-3 gap-4">
                        {hmiData.apSuat?.map((ap, i) => (
                          <div key={i} className="bg-white/5 p-4 rounded-2xl border border-white/5 text-center">
                            <p className="text-[9px] font-black text-white/20 uppercase mb-1">{ap.id}</p>
                            <p className="text-xl font-black font-mono text-brand-primary">{ap.val}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                    <div className="glass-card p-8 rounded-[3rem] space-y-6">
                      <h4 className="text-[11px] font-black uppercase tracking-widest opacity-40 flex items-center gap-3"><Wind size={16}/> Hệ thống quạt Hz</h4>
                      <div className="space-y-3">
                        {hmiData.quat?.map((q, i) => (
                          <div key={i} className="flex justify-between items-center p-4 bg-white/5 rounded-2xl border border-white/5">
                            <span className="text-[10px] font-black uppercase opacity-40 font-mono truncate max-w-[150px]">{q.name}</span>
                            <span className="text-brand-primary font-black font-mono">{q.hz} HZ</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </motion.div>
            )}
          </div>
        )}

        {activeMenu === 'Cơ sở dữ liệu' && (
          <div className="glass-card rounded-[3rem] overflow-hidden animate-in fade-in duration-700 shadow-2xl">
            <div className="p-10 border-b border-white/5 flex justify-between items-center">
              <h3 className="text-2xl font-black uppercase tracking-tighter flex items-center gap-4 text-brand-primary">
                <DatabaseIcon size={32}/> Thư viện mẻ nung Cloud
              </h3>
              <div className="flex gap-4">
                <div className="glass-btn p-4 rounded-xl flex items-center gap-3"><Search size={18} className="text-white/20"/><input type="text" placeholder="Tìm mẻ..." className="bg-transparent outline-none font-black text-xs uppercase" /></div>
              </div>
            </div>
            <div className="overflow-x-auto">
              <table className="w-full text-left font-bold">
                <thead className="bg-white/5 text-white/20 uppercase text-[10px] tracking-widest">
                  <tr><th className="p-6">Thời gian</th><th className="p-6">Sản phẩm</th><th className="p-6">Loại lò</th><th className="p-6 text-center">Lực bẻ</th><th className="p-6 text-right">Hành động</th></tr>
                </thead>
                <tbody>
                  {cloudLogs.map((log, i) => (
                    <tr key={i} className="border-b border-white/[0.03] hover:bg-white/5 transition-all">
                      <td className="p-6 text-xs font-mono opacity-40">{new Date(log.created_at).toLocaleString('vi-VN')}</td>
                      <td className="p-6 font-black uppercase text-sm tracking-tight">{log.product_type}</td>
                      <td className="p-6"><span className="px-3 py-1 bg-brand-primary/10 text-brand-primary text-[10px] font-black rounded-full uppercase">{log.kiln_type}</span></td>
                      <td className="p-6 text-center font-black text-brand-primary">{log.strength_value}N</td>
                      <td className="p-6 text-right"><button className="glass-btn p-3 rounded-xl"><Eye size={18}/></button></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </main>

      {/* CHATBOT */}
      <AnimatePresence>
        {isChatOpen && (
          <motion.div initial={{ opacity: 0, y: 100 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: 100 }} className="fixed bottom-32 right-12 w-[400px] h-[600px] glass-card rounded-[3rem] shadow-[0_0_50px_rgba(0,0,0,0.8)] z-50 overflow-hidden flex flex-col border-brand-primary/20">
            <div className="p-6 bg-brand-primary/10 border-b border-white/5 flex justify-between items-center">
              <div className="flex items-center gap-3"><Bot className="text-brand-primary" size={24} /><h4 className="font-black text-xs uppercase tracking-widest">Trợ lý KCS AI</h4></div>
              <button onClick={()=>setIsChatOpen(false)} className="text-white/20 hover:text-white"><X size={20}/></button>
            </div>
            <div className="flex-1 p-6 overflow-y-auto space-y-6">
              {chatMessages.map((m, i) => (
                <div key={i} className={cn("flex", m.role === 'user' ? "justify-end" : "justify-start")}>
                  <div className={cn("max-w-[85%] p-4 rounded-2xl text-xs font-medium leading-relaxed", m.role === 'user' ? "bg-brand-primary text-brand-bg rounded-br-none" : "bg-white/5 border border-white/10 text-white/80 rounded-bl-none")}>
                    {m.text}
                  </div>
                </div>
              ))}
              <div ref={chatEndRef} />
            </div>
            <div className="p-6 border-t border-white/5 flex gap-3">
              <input value={chatInput} onChange={(e)=>setChatInput(e.target.value)} onKeyDown={(e)=>e.key==='Enter'&&handleSendMessage()} type="text" placeholder="Hỏi AI về dải nhiệt..." className="flex-1 bg-white/5 border border-white/10 rounded-2xl px-6 text-xs font-medium outline-none focus:border-brand-primary" />
              <button onClick={handleSendMessage} className="w-12 h-12 bg-brand-primary text-brand-bg rounded-2xl flex items-center justify-center hover:scale-105 active:scale-95 transition-all shadow-lg"><Send size={18}/></button>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
      <button onClick={()=>setIsChatOpen(!isChatOpen)} className="fixed bottom-12 right-12 w-16 h-16 bg-brand-primary text-brand-bg rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(212,176,123,0.4)] hover:scale-110 active:scale-95 transition-all z-50">
        <MessageSquare size={28} />
      </button>
    </div>
  );
}

function Plus(props) {
  return (
    <svg {...props} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
  );
}
